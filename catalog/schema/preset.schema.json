{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4FusionLab/Filamentra-DataSource/blob/main/catalog/schema/preset.schema.json",
  "title": "Filamentra Visual Preset (pre-release Schema v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "provenance",
    "status",
    "appearance",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "const": "filamentra_estimate"
    },
    "status": {
      "enum": [
        "uncalibrated",
        "fusion_tested",
        "reference_calibrated"
      ]
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface_type": {
          "type": "string",
          "enum": [
            "opaque",
            "metallic",
            "transparent"
          ],
          "description": "Fusion AppearanceSurfaceTypes selection."
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Microfacet roughness, not physical surface-height roughness."
        },
        "opacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "RGBA alpha, not volumetric transmission."
        },
        "ior": {
          "type": "number",
          "minimum": 1,
          "maximum": 3,
          "description": "Transparent index of refraction, advanced appearanceProperties mapping; runtime validation required."
        },
        "attenuation_distance_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Physical reference length in mm for transparent optical attenuation; convert to Fusion property units after runtime inspection."
        },
        "textures": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_color": {
              "type": "string",
              "pattern": "^assets/[A-Za-z0-9/_-]+\\.(?:png|jpg|jpeg)$"
            },
            "normal_gl": {
              "type": "string",
              "pattern": "^assets/[A-Za-z0-9/_-]+\\.(?:png|jpg|jpeg)$"
            },
            "roughness": {
              "type": "string",
              "pattern": "^assets/[A-Za-z0-9/_-]+\\.(?:png|jpg|jpeg)$"
            },
            "tile_width_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tile_height_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
