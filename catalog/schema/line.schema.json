{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4FusionLab/Filamentra-DataSource/blob/main/catalog/schema/line.schema.json",
  "title": "Filamentra Product Line (pre-release Schema v1)",
  "description": "Manufacturer-sourced product line and colors with optional Fusion-oriented appearance presets and per-field provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "brand",
    "name",
    "polymer",
    "source_url",
    "colors"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "brand": {
      "$ref": "#/$defs/slug"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "polymer": {
      "type": "string",
      "minLength": 1
    },
    "finish": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "appearance_preset": {
      "$ref": "#/$defs/slug"
    },
    "appearance": {
      "$ref": "#/$defs/appearance"
    },
    "appearance_sources": {
      "$ref": "#/$defs/source_map"
    },
    "colors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/color"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface_type": {
          "type": "string",
          "enum": [
            "opaque",
            "metallic",
            "transparent"
          ],
          "description": "Fusion AppearanceSurfaceTypes selection."
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Microfacet roughness, not physical surface-height roughness."
        },
        "opacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "RGBA alpha, not volumetric transmission."
        },
        "ior": {
          "type": "number",
          "minimum": 1,
          "maximum": 3,
          "description": "Transparent index of refraction, advanced appearanceProperties mapping; runtime validation required."
        },
        "attenuation_distance_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Physical reference length in mm for transparent optical attenuation; convert to Fusion property units after runtime inspection."
        },
        "textures": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_color": {
              "type": "string",
              "pattern": "^assets/[A-Za-z0-9/_-]+\\.(?:png|jpg|jpeg)$"
            },
            "normal_gl": {
              "type": "string",
              "pattern": "^assets/[A-Za-z0-9/_-]+\\.(?:png|jpg|jpeg)$"
            },
            "roughness": {
              "type": "string",
              "pattern": "^assets/[A-Za-z0-9/_-]+\\.(?:png|jpg|jpeg)$"
            },
            "tile_width_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tile_height_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "source_map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface_type": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "manufacturer",
                "measured",
                "filamentra_estimate"
              ]
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "notes": {
              "type": "string",
              "minLength": 1
            },
            "verified_on": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "roughness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "manufacturer",
                "measured",
                "filamentra_estimate"
              ]
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "notes": {
              "type": "string",
              "minLength": 1
            },
            "verified_on": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "opacity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "manufacturer",
                "measured",
                "filamentra_estimate"
              ]
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "notes": {
              "type": "string",
              "minLength": 1
            },
            "verified_on": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "ior": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "manufacturer",
                "measured",
                "filamentra_estimate"
              ]
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "notes": {
              "type": "string",
              "minLength": 1
            },
            "verified_on": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "attenuation_distance_mm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "manufacturer",
                "measured",
                "filamentra_estimate"
              ]
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "notes": {
              "type": "string",
              "minLength": 1
            },
            "verified_on": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "textures": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "manufacturer",
                "measured",
                "filamentra_estimate"
              ]
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "notes": {
              "type": "string",
              "minLength": 1
            },
            "verified_on": {
              "type": "string",
              "format": "date"
            }
          }
        }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "source_url"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "manufacturer_color_code": {
          "type": "string",
          "minLength": 1
        },
        "hex": {
          "type": "string",
          "pattern": "^#[A-Fa-f0-9]{6}$"
        },
        "hex_source": {
          "type": "string",
          "enum": [
            "manufacturer",
            "measured",
            "estimated"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "verified_on": {
          "type": "string",
          "format": "date"
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        },
        "appearance_sources": {
          "$ref": "#/$defs/source_map"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sku"
            ],
            "properties": {
              "sku": {
                "type": "string",
                "minLength": 1
              },
              "diameter_mm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "weight_g": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "packaging": {
                "type": "string",
                "enum": [
                  "spool",
                  "refill",
                  "sample",
                  "other"
                ]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "hex"
            ]
          },
          "then": {
            "required": [
              "hex_source"
            ]
          }
        },
        {
          "if": {
            "required": [
              "hex_source"
            ]
          },
          "then": {
            "required": [
              "hex"
            ]
          }
        }
      ]
    }
  }
}
